<?xml version="1.0" encoding="utf-8"?>
<!--
  AnythingMobile 启动图标前景 —— 第三轮"镜中字母 A"：
  浅靛底上的一枚深靛实心放大镜，镜片（透底）内是 Anything 的首字母 A。
  单一粗壮剪影 + 负空间，设计语言对齐 ImageToolbox（浅底深图、同色系高对比）。
  镜片为真实透明（无遮挡物），主题图标(monochrome)下 A 与镜环天然成立。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 45° 圆头镜柄（先画，近端压入镜环相融） -->
    <path
        android:pathData="M65.23,64.23 L71.59,70.59"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeLineCap="round"
        android:strokeWidth="9.5" />

    <!-- 镜片环：外 R19 / 内 R12（evenOdd，镜内透底） -->
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:fillType="evenOdd"
        android:pathData="M33.5,51.5 a19,19 0 1 0 38,0 a19,19 0 1 0 -38,0 Z M40.5,51.5 a12,12 0 1 0 24,0 a12,12 0 1 0 -24,0 Z" />

    <!-- 字母 A：两腿 + 横杠（圆头，腿端与镜环相融） -->
    <path
        android:pathData="M52.5,45.5 L46.3,59.5 M52.5,45.5 L58.7,59.5 M47.8,55.5 L57.2,55.5"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeLineCap="round"
        android:strokeWidth="5.2" />
</vector>
