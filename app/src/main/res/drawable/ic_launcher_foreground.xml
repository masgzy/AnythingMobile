<?xml version="1.0" encoding="utf-8"?>
<!--
  AnythingMobile 启动图标前景 —— "镜下文件名"：
  一枚粗壮的实心放大镜，镜片内以负空间镂刻两行文件名，
  对象（文件行）与动作（搜索）融为一体，单一剪影，
  设计语言对齐 ImageToolbox（实心粗体 + 负空间 + 高对比）。
  镜片内的文件行用 evenOdd 真镂空：主题图标(monochrome)下同样保留。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 镜柄：45° 圆头粗柄 -->
    <path
        android:pathData="M67.15,67.15 L75.15,75.15"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeLineCap="round"
        android:strokeWidth="11" />

    <!-- 镜片：实心圆 + 两行文件名镂空（evenOdd） -->
    <path
        android:fillColor="@color/ic_launcher_foreground"
