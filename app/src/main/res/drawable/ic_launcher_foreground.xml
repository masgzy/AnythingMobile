<?xml version="1.0" encoding="utf-8"?>
<!--
  AnythingMobile 启动图标前景 —— 第五轮「Windows 空文件 + 右下角放大镜」(用户指定构图):
  实心纸剪影(27x35, 圆角 3.5) + 右上 Windows 折角(切口 9 + 切口内悬浮小三角 5.6,
  与斜边垂直缝 2.4) + 右下角放大镜骑角(环 r11/宽 4.6, 与纸间 2.4 透底间隙 =
  纸张 r15.7 正圆咬口; 45° 圆头柄)。
  ImageToolbox 语言: 浅同色系底 + 深色实心剪影 + 负空间; 铁律: 结构实心、
  负空间切口全圆润、可见区留白约 13 单位、单一焦点(放大镜)。
  镜片孔与折角缝均为真实透底 → monochrome 主题图标直接共用本矢量。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 纸张: 顶边 → 折角斜切 → 右短边 → r15.7 圆弧咬口(镜片透底) → 底边 → 左侧圆角回路 -->
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M37.03,30.53 H51.53 L60.53,39.53 V45.53 A15.7,15.7 0 0 0 42.99,65.53 H37.03 A3.5,3.5 0 0 1 33.53,62.03 V34.03 A3.5,3.5 0 0 1 37.03,30.53 Z" />

    <!-- 折角小三角: 悬浮于切口透底区内、贴原始角点 -->
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M54.92,30.53 H60.53 V36.13 Z" />

    <!-- 镜环(描边圆) -->
    <path
        android:pathData="M47.03,61.03 a11,11 0 1 0 22,0 a11,11 0 1 0 -22,0 Z"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeWidth="4.6" />

    <!-- 45° 圆头镜柄 -->
    <path
        android:pathData="M65.81,68.81 L72.17,75.17"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeWidth="4.6"
        android:strokeLineCap="round" />
</vector>
